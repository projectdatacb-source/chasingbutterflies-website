# Public site URL used for canonical and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and the publishable/anon key.
# These are safe to expose in the browser. They can only read published films.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Sent as: Authorization: Bearer <secret>
ADMIN_API_SECRET=
